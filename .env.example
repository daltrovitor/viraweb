# Hosts (no scheme, no port). Defaults shown.
FACTORY_HOST=factory.viraweb.dev.br
OPS_HOST=ops.viraweb.dev.br

# Public URLs used in links (main site → Factory CTA, Factory → main site)
NEXT_PUBLIC_FACTORY_URL=https://factory.viraweb.dev.br
NEXT_PUBLIC_SITE_URL=https://viraweb.dev.br

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys / Webhooks). Use sk_test_ while testing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
